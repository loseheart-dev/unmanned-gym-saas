#!/usr/bin/env bash
set -euo pipefail

# Git-generated merge commits are not authored changes.
if git rev-parse --verify -q MERGE_HEAD >/dev/null; then
  exit 0
fi

subject=$(git stripspace --strip-comments < "$1" | sed -n '1p')
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9._/-]*\))?!?: [^[:space:]]'
if [[ ! $subject =~ $pattern ]]; then
  printf '%s\n' 'Use a Conventional Commit title, e.g. feat: add booking or fix(auth): reject expired tokens.' >&2
  exit 1
fi
